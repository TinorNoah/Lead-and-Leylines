# Public GitHub repo that hosts docs/installed/catalog.json
GITHUB_REPO=TinorNoah/Lead-and-Leylines
GITHUB_BRANCH=main

# Optional: raises GitHub API rate limits for the commit poll
# GITHUB_TOKEN=

# Optional: CurseForge icons and summaries (without it, cards use monograms + CF links)
# CURSEFORGE_API_KEY=

# Shared secret for GitHub push webhooks (X-Hub-Signature-256)
REVALIDATE_SECRET=change-me

# How often to poll GitHub for a new commit SHA (seconds)
CACHE_TTL_SECONDS=600

# Writable volume for last-good catalog + metadata cache
DATA_DIR=/data

# Baked seed path inside the container image
SEED_CATALOG_PATH=/app/seed/catalog.json
