# Copy to .env at the repo root. Never commit .env.

# Application API (papp_...). Create it in the panel under Application API Keys.
PANEL_URL=https://example.invalid
PANEL_API_KEY=

# Wings node to deploy onto.
PANEL_NODE_FQDN=example.invalid
PANEL_NODE_NAME=node

# Panel user that owns the server.
PANEL_OWNER_USERNAME=tinor

# Optional overrides. Defaults come from pack/pack.toml name and these values.
PANEL_SERVER_NAME=Lead and Leylines
PANEL_EXTERNAL_ID=lead-and-leylines
PANEL_MEMORY_MB=8192
PANEL_DISK_MB=0
# Leave empty to use the first free allocation on the node.
PANEL_PORT=

# CurseForge Generic egg variables. PROJECT_ID is the numeric CF modpack id
# (not in git). API_KEY is a CurseForge console key; if unset, the script copies
# one from another CurseForge Generic server on this panel.
CURSEFORGE_PROJECT_ID=
CURSEFORGE_API_KEY=
CURSEFORGE_VERSION_ID=latest
