# Copy to .env at the repo root. Never commit .env.

# Publishing (scripts/release.py). Never commit these values.
# GH_TOKEN needs permission to create releases and upload assets (including the server-mods zip).
GH_TOKEN=
# CurseForge is off unless release.py is passed --curseforge (GitHub Actions
# secrets) or --upload-stores (these local values).
CURSEFORGE_TOKEN=
CURSEFORGE_PROJECT_ID=

# Optional local Prism instance folder (contains instance.cfg). If unset,
# scripts/update_prism.py looks under %APPDATA%/PrismLauncher/instances for
# an instance whose name matches pack/pack.toml. Override PRISM_ROOT if Prism
# is not in the default AppData location.
PRISM_INSTANCE_DIR=
PRISM_ROOT=

# Dedicated test server. Put the real panel URL and node FQDN in .env only.
PANEL_URL=
PANEL_API_KEY=
PANEL_NODE_FQDN=
PANEL_NODE_NAME=node
EGG_IMPORT_URL=

# Panel user that owns the server.
PANEL_OWNER_USERNAME=

# Optional overrides. Defaults come from pack/pack.toml name and these values.
PANEL_SERVER_NAME=Lead and Leylines
PANEL_EXTERNAL_ID=lead-and-leylines
PANEL_MEMORY_MB=8192
PANEL_DISK_MB=0
# Leave empty to use the first free allocation on the node.
PANEL_PORT=

# CurseForge Generic egg variables (only needed for --curseforge after the pack is public).
# PROJECT_ID is the numeric CF modpack id (not in git). API_KEY is a CurseForge console
# key; if unset, the script copies one from another CurseForge Generic server on this panel.
# Until then, `python scripts/deploy_server.py` pushes the local pack tree instead.
# lookup_mod.py also uses CURSEFORGE_API_KEY as the CurseForge Core API key for research.
CURSEFORGE_API_KEY=
CURSEFORGE_VERSION_ID=latest
